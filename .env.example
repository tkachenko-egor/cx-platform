ANTHROPIC_API_KEY=
DATABASE_PATH=./cx-platform.db

# Optional now — set once and use Admin > API Keys instead for anything
# beyond local dev. 32 random bytes, base64 (e.g. `openssl rand -base64 32`);
# only required once a tenant stores a key via the admin UI.
CREDENTIAL_ENCRYPTION_KEY=

# Email channel (src/channel/email/) — omit SMTP_HOST to use the zero-network
# stub provider (NFR-9.5), which logs instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@example.com
